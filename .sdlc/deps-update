#!/usr/bin/env bash
#
# Updates the versions this project declares itself to the latest release, then
# shows the resulting git diff. It does not build: review the diff, then run the build.
#
# Updated: the parent POM, version properties (dependencies, imported BOMs, plugins),
# dependencies with a version written in the POMs.
# Not updated: versions inherited from an imported BOM or from a parent POM (for
# example Jackson from the Quarkus BOM), and plugin versions written without a
# property (versions-maven-plugin cannot change them): those are listed at the end.
#
# Settings, as environment variables or in an optional .sdlc/deps.env file:
#   DEPS_VERSIONS_PLUGIN    versions-maven-plugin version
#   DEPS_IGNORE_VERSIONS    regex of the versions to ignore (default: pre-releases)
#   DEPS_ALLOW_MAJOR        "false" to apply only minor and patch updates (default: true)
#   DEPS_EXCLUDES           comma separated groupId:artifactId patterns to skip
#   DEPS_EXCLUDE_PROPERTIES comma separated version properties to skip
#   DEPS_MAVEN_ARGS         extra Maven arguments, e.g. "-Pexamples"
# Script arguments are passed to Maven as well.

set -e

tool_source="${BASH_SOURCE[0]}"
while [ -h "$tool_source" ] ; do tool_source="$(readlink "$tool_source")"; done
sdlc_dir="$( cd -P "$( dirname "$tool_source" )" && pwd )"
prj_home="$( cd -P "$( dirname "$sdlc_dir" )" && pwd )"

cd "${prj_home}"

# shellcheck source=/dev/null
[[ -f "${sdlc_dir}/deps.env" ]] && source "${sdlc_dir}/deps.env"

if [[ -x ./mvnw ]]; then
  mvn_cmd='./mvnw'
elif hash mvn 2>/dev/null; then
  mvn_cmd='mvn'
else
  echo 'No Maven executable: aborting'
  exit 1
fi

# The diff at the end must show only the changes made by this script.
pom_files=':(glob)**/pom.xml'
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [[ -n "$(git status --porcelain -- "${pom_files}")" ]]; then
    echo 'Uncommitted changes in pom.xml files: commit or stash them first. Aborting'
    exit 1
  fi
  in_git=true
else
  in_git=false
fi

versions_plugin="org.codehaus.mojo:versions-maven-plugin:${DEPS_VERSIONS_PLUGIN:-2.23.0}"
ignore_versions="${DEPS_IGNORE_VERSIONS:-(?i).*[-.](alpha|beta|rc|cr|m|ea|preview|snapshot)[-.]?\d*\b.*}"

# shellcheck disable=SC2206
maven_args=(-B -ntp ${DEPS_MAVEN_ARGS:-} "-Dmaven.version.ignore=${ignore_versions}"
  "-DallowMajorUpdates=${DEPS_ALLOW_MAJOR:-true}" -DgenerateBackupPoms=false "$@")
if [[ -n "${DEPS_EXCLUDES:-}" ]]; then
  maven_args+=("-Dexcludes=${DEPS_EXCLUDES}")
fi
property_args=()
if [[ -n "${DEPS_EXCLUDE_PROPERTIES:-}" ]]; then
  property_args=("-DexcludeProperties=${DEPS_EXCLUDE_PROPERTIES}")
fi

# Turns a versions plugin output into "name current -> newest" lines, one per name with
# its highest version. Dropped: lines that are not upgrades (when a project does not
# declare its minimum Maven version, display-plugin-updates also lists older versions,
# grouped by the Maven version they require) and versions set through a property.
newer_versions() {
  grep -F -- ' -> ' \
    | awk '{ print $2 "\t" $(NF-2) "\t" $NF }' \
    | sort -t $'\t' -k1,1 -k3,3V \
    | awk -F '\t' '{ last[$1] = $0 } END { for (name in last) print last[name] }' \
    | while IFS=$'\t' read -r name current newest; do
        [[ "${current}" == "${newest}" || "${current}" == '$'* ]] && continue
        [[ "$(printf '%s\n%s\n' "${current}" "${newest}" | sort -V | tail -n 1)" == "${newest}" ]] || continue
        printf '  %-60s %s -> %s\n' "${name}" "${current}" "${newest}"
      done \
    | sort
}

# Runs a versions plugin goal. Its Maven output is printed only for display-* goals,
# or on stderr when the goal fails.
versions() {
  local goal="$1"
  shift
  local output
  output="$("${mvn_cmd}" "${maven_args[@]}" "$@" "${versions_plugin}:${goal}")" || {
    echo "${output}" >&2
    echo "versions:${goal} failed: aborting" >&2
    exit 1
  }
  if [[ "${goal}" == display-* ]]; then
    echo "${output}"
  fi
}

echo '--- Updating parent, properties and dependencies'
versions update-parent
versions update-properties "${property_args[@]}"
# Only versions written in the POMs are changed: version-less dependencies keep
# following their BOM.
versions use-latest-releases -DprocessDependencies=true -DprocessDependencyManagement=true

echo '--- Changes'
if [[ "${in_git}" == true ]]; then
  git --no-pager diff --stat -- "${pom_files}"
  git --no-pager diff -- "${pom_files}"
else
  echo 'Not a git repository: no diff to show'
fi

echo '--- Plugin updates to apply by hand'
plugin_updates="$(versions display-plugin-updates -Dversions.outputLineWidth=250)"
plugins="$(newer_versions <<< "${plugin_updates}")"
echo "${plugins:-  none}"
